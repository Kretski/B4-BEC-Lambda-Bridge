+def rank1_check(tag, rec):
+    """Exact rank-one input check: delta_rank1 = |kappa^2/(p s) - 1|; ABORT above RANK1_ABORT_REL."""
+    if rec['s'] > 0:
+        d1 = abs(rec['kappa']**2/(rec['p']*rec['s']) - 1)
