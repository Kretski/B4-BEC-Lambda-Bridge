+    if d1 > RANK1_ABORT_REL:
+        raise SystemExit("ABORT: rank-one input condition violated for %s: |kappa^2/(p s) - 1| = %s > 1e-9"
+                         % (tag, sp.N(d1, 10)))
+    return d1
+
